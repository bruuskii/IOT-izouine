# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Official Fedora 45 box, downloaded from Fedora itself (not the HashiCorp registry).
  config.vm.box     = "fedora-45-cloud-official"
  config.vm.box_url = "https://download.fedoraproject.org/pub/fedora/linux/releases/45/Cloud/x86_64/images/Fedora-Cloud-Base-Vagrant-VirtualBox-45-1.4.x86_64.vagrant.virtualbox.box"

  # This box has no VirtualBox Guest Additions, so no shared /vagrant folder.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.define "izouineS" do |izouineS|
    izouineS.vm.hostname = "izouineS"
    izouineS.vm.network "private_network", ip: "192.168.56.110"
    izouineS.vm.provider "virtualbox" do |vb|
      # --ioapic on: without it the VM is far too slow under nested virtualization.
      vb.customize ["modifyvm", :id, "--name", "izouineS", "--ostype", "Fedora_64",
                    "--paravirtprovider", "none", "--ioapic", "on"]
      vb.memory = "1024"
      vb.cpus = 2
    end
    izouineS.vm.provision "shell", path: "scripts/server.sh"
  end

  config.vm.define "izouineSW" do |izouineSW|
    izouineSW.vm.hostname = "izouineSW"
    izouineSW.vm.network "private_network", ip: "192.168.56.111"
    izouineSW.vm.provider "virtualbox" do |vb|
      vb.customize ["modifyvm", :id, "--name", "izouineSW", "--ostype", "Fedora_64",
                    "--paravirtprovider", "none", "--ioapic", "on"]
      vb.memory = "1024"
      vb.cpus = 1
    end
    izouineSW.vm.provision "shell", path: "scripts/agent.sh"
  end
end
